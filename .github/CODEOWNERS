# CODEOWNERS for sc-kpi-web
# https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
#
# Teams hierarchy (sc-kpi/digital-transformation):
#   leadership / management, tech-leads
#   engineering / frontend, backend, devops
#   design
#   qa / qa-manual, qa-automation

# Default owners — Tech Leads have oversight of all code
*                           @sc-kpi/tech-leads

# Frontend application code
/src/                       @sc-kpi/frontend @sc-kpi/tech-leads

# Styling and design-related
/src/**/*.css               @sc-kpi/frontend @sc-kpi/design
/public/                    @sc-kpi/frontend @sc-kpi/design
tailwind.config.*           @sc-kpi/frontend @sc-kpi/design

# Tests
/src/**/*.test.*            @sc-kpi/frontend @sc-kpi/qa-automation
/src/**/*.spec.*            @sc-kpi/frontend @sc-kpi/qa-automation
/e2e/                       @sc-kpi/qa-automation @sc-kpi/frontend
/cypress/                   @sc-kpi/qa-automation @sc-kpi/frontend
/playwright/                @sc-kpi/qa-automation @sc-kpi/frontend

# Configuration and infrastructure
/.github/                   @sc-kpi/devops @sc-kpi/tech-leads
Dockerfile                  @sc-kpi/devops
docker-compose*.yml         @sc-kpi/devops
*.config.js                 @sc-kpi/frontend @sc-kpi/devops
*.config.ts                 @sc-kpi/frontend @sc-kpi/devops
*.config.mjs                @sc-kpi/frontend @sc-kpi/devops

# Security-sensitive files (requires tech lead approval)
/src/**/middleware.ts        @sc-kpi/tech-leads @sc-kpi/frontend
/src/**/auth/               @sc-kpi/tech-leads @sc-kpi/frontend
/src/**/security/           @sc-kpi/tech-leads @sc-kpi/frontend

# Documentation
*.md                        @sc-kpi/management
/docs/                      @sc-kpi/management @sc-kpi/tech-leads
CHANGELOG.md                @sc-kpi/management @sc-kpi/devops
